[Desktop Entry]
Name=moregram
Comment=Unofficial Telegram Desktop-based messenger
TryExec=Telegram
Exec=Telegram -- %U
Icon=io.github.capricornus007.moregram
Terminal=false
# StartupWMClass 必須等於 Qt 的 WM_CLASS，後者來自 core/launcher.cpp 的
# QApplication::setApplicationName("moregram")；兩欄位要一起改。
StartupWMClass=moregram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;x-scheme-handler/ton;
Keywords=tg;chat;im;messaging;messenger;sms;tdesktop;moregram;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=Telegram -quit
Name=Quit moregram
Icon=application-exit
